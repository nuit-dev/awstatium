#: includes/settings.php:17 includes/settings.php:92
msgid "Awstatium settings"
msgstr "Awstatium postavke"

#. translators: %s: directory path
#: includes/settings.php:28
#, php-format
msgid "The directory %s does not exist or PHP is not allowed to read it."
msgstr "Mapa %s ne postoji ili je PHP ne smije čitati."

#: includes/settings.php:54
msgid "Settings"
msgstr "Postavke"

#: includes/settings.php:77
msgid "Reload AWStats data"
msgstr "Ponovno učitaj AWStats podatke"

#: includes/settings.php:96
msgid "Status"
msgstr "Stanje"

#: includes/settings.php:100
msgid "AWStats files found"
msgstr "Pronađene AWStats datoteke"

#: includes/settings.php:102
msgid "None – check the directory and config below."
msgstr "Nijedna – provjerite mapu i konfiguraciju ispod."

#: includes/settings.php:103
msgid "Months loaded"
msgstr "Učitani mjeseci"

#: includes/settings.php:104
msgid "Last AWStats update"
msgstr "Zadnje osvježavanje AWStatsa"

#: includes/settings.php:106
msgid "Permalinks"
msgstr "Stalne veze"

#: includes/settings.php:106
msgid ""
"Plain permalinks (?p=123) are in use. AWStats ignores query strings, so "
"views per page cannot be counted. Choose another structure in Settings → "
"Permalinks."
msgstr "Koriste se obične stalne veze (?p=123). AWStats zanemaruje parametre u adresi, pa se pregledi po stranici ne mogu brojati. Odaberite drugu strukturu u Postavke → Stalne veze."

#: includes/settings.php:109
msgid ""
"PHP can only read these directories. If the AWStats directory is outside "
"them, ask your host or copy the files to an allowed directory with a cron "
"job."
msgstr "PHP smije čitati samo ove mape. Ako je AWStats mapa izvan njih, obratite se hostingu ili cron zadatkom kopirajte datoteke u dopuštenu mapu."

#: includes/settings.php:119
msgid "AWStats data directory"
msgstr "Mapa s AWStats podacima"

#: includes/settings.php:121
msgid ""
"Directory with files named awstatsMMYYYY.example.com.txt. On cPanel this is "
"usually ~/tmp/awstats/ssl (HTTPS) or ~/tmp/awstats (HTTP)."
msgstr "Mapa s datotekama imena awstatsMMYYYY.primjer.hr.txt. Na cPanelu je to obično ~/tmp/awstats/ssl (HTTPS) ili ~/tmp/awstats (HTTP)."

#: includes/settings.php:128
msgid "Found on this server:"
msgstr "Pronađeno na ovom poslužitelju:"

#: includes/settings.php:132 includes/settings.php:149
msgid "Use"
msgstr "Koristi"

#: includes/settings.php:139
msgid "AWStats config"
msgstr "AWStats konfiguracija"

#: includes/settings.php:141
msgid ""
"The middle part of the file names, usually your domain. Addon domains on "
"cPanel look like example.com.maindomain.com."
msgstr "Srednji dio imena datoteka, obično vaša domena. Dodatne domene na cPanelu izgledaju ovako: primjer.hr.glavnadomena.hr."

#: includes/settings.php:144
msgid "In this directory:"
msgstr "U ovoj mapi:"

#. translators: %s: number of monthly files
#: includes/settings.php:147
#, php-format
msgid "%s month"
msgid_plural "%s months"
msgstr[0] "%s mjesec"
msgstr[1] "%s mjeseca"
msgstr[2] "%s mjeseci"

#: includes/settings.php:156
msgid "Show views automatically"
msgstr "Automatski prikaži preglede"

#: includes/settings.php:161
msgid "Position:"
msgstr "Položaj:"

#: includes/settings.php:162
msgid "Below the content"
msgstr "Ispod sadržaja"

#: includes/settings.php:163
msgid "Above the content"
msgstr "Iznad sadržaja"

#: includes/settings.php:165
msgid ""
"Adds e.g. \"1,234 views\" to single posts of the selected types. It is "
"hidden while the count is 0. You can also use the [awstatium_views] "
"shortcode or awstatium_get_views() in your theme."
msgstr "Dodaje npr. „1.234 pregleda“ na pojedinačne objave odabranih vrsta. Ne prikazuje se dok je broj 0. Možete koristiti i shortcode [awstatium_views] ili awstatium_get_views() u temi."

#: includes/settings.php:169
msgid "Page cache"
msgstr "Predmemorija stranica"

#: includes/settings.php:170
msgid "Purge the page cache when new AWStats data arrives"
msgstr "Očisti predmemoriju stranica kad stignu novi AWStats podaci"

#: includes/settings.php:171
msgid ""
"Supports LiteSpeed Cache, WP Rocket, W3 Total Cache, WP Super Cache, Cache "
"Enabler and SiteGround Speed Optimizer. Other plugins can use the "
"awstatium_purge_cache action."
msgstr "Podržava LiteSpeed Cache, WP Rocket, W3 Total Cache, WP Super Cache, Cache Enabler i SiteGround Speed Optimizer. Drugi plugini mogu koristiti akciju awstatium_purge_cache."

#. Description of the plugin
msgid "Page views, downloads and traffic statistics from your server's AWStats data. No tracking scripts, no cookies."
msgstr "Pregledi stranica, preuzimanja i statistika posjećenosti iz AWStats podataka vašeg poslužitelja. Bez skripti za praćenje i bez kolačića."
