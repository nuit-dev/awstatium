#: awstatium.php:40 includes/data.php:517
msgid "Awstatium does not support WordPress Multisite yet."
msgstr "Awstatium još ne podržava WordPress Multisite."

#: includes/admin.php:12
msgid "Invalid request."
msgstr "Neispravan zahtjev."

#: includes/admin.php:13
msgid "You are not allowed to do this."
msgstr "Nemate ovlasti za ovu radnju."

#: includes/admin.php:23
msgid "AWStats data reloaded."
msgstr "AWStats podaci ponovno su učitani."

#: includes/admin.php:24
msgid "No new data, everything was already loaded."
msgstr "Nema novih podataka, sve je već bilo učitano."

#: includes/admin.php:25
msgid ""
"Loaded, but some AWStats files were skipped (incomplete or being written), "
"so the previous data was kept for those months. Details are in the PHP error "
"log."
msgstr ""
"Učitano, ali neke AWStats datoteke su preskočene (nepotpune ili su se upravo "
"zapisivale), pa su za te mjesece zadržani prijašnji podaci. Detalji su u PHP "
"error logu."

#: includes/admin.php:26 includes/settings.php:90
msgid ""
"Saving to the database failed, the last saved data is shown. Details are in "
"the PHP error log."
msgstr ""
"Spremanje u bazu nije uspjelo, prikazuju se zadnji spremljeni podaci. "
"Detalji su u PHP error logu."

#: includes/admin.php:27
msgid "Another refresh is running. Try again in a minute."
msgstr "Upravo je u tijeku drugo osvježavanje. Pokušajte ponovno za minutu."

#: includes/admin.php:40
msgid "Awstatium has no AWStats data yet."
msgstr "Awstatium još nema AWStats podataka."

